<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScreenScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

    <Button
        android:id="@+id/btnHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="도움말"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:textColor="@color/color_help"
        android:textSize="12sp"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btnFinanceQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="금융 문제"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnEconomyQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="경제 문제"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnPublicQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="공공 문제"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnWrongNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="틀린 문제 오답노트"
        android:layout_marginTop="30dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        android:paddingTop="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvQuizResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="최근 퀴즈 결과가 없습니다."
            android:textSize="14sp"/>
    </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
