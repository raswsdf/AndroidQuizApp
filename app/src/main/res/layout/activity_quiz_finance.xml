<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFinanceScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="점수: 100"
        android:textSize="18sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvFinanceProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="진행 상황: 1/5"
        android:textSize="18sp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvFinanceQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="문제 설명"
        android:textSize="20sp"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btnFinanceOp1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnFinanceOp2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnFinanceOp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnFinanceOp4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnFinanceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="힌트"
        android:padding="8dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp" />

    <!-- 페이지 넘기기 버튼 -->
    <Button
        android:id="@+id/btnNextPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다음 페이지"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp" />

</LinearLayout>
