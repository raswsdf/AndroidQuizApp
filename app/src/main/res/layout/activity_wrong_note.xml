<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <Button
        android:id="@+id/btnHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="도움말"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:textColor="@android:color/holo_blue_dark"
        android:textSize="12sp"
         />

    <Button
        android:id="@+id/btnFinanceQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finance 문제 목록"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEconomyQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Economy 문제 목록"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnPublicQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Public 문제 목록"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvWrongNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="틀린 문제를 보고 싶은 카테고리를 선택해주세요."
        android:gravity="center"
        android:layout_marginTop="32dp"/>

</LinearLayout>
